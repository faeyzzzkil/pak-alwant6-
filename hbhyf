#include <iostream>
#include <string>
using namespace std;

int main() {
    string menu[2] = {"soto", "rawon"};
    int harga[2] = {15000, 20000};
    int porsi[2];
    int total[2];
    int i;

    for(i = 0; i < 2; i++) {
        cout << "Menu: ";
        cout << menu[i] << endl;
        cout << "Harga: ";
        cout << harga[i] << endl;
        cout << "Masukkan porsi: ";
        cin >> porsi[i];
        total[i] = porsi[i] * harga[i];
        cout << "Total: ";
        cout << total[i] << endl;
        cout << "_________________" << endl;
    }

    return 0;
}
